// ====== CHART: BREAKDOWN ======
function renderBreakdown() {
  const mode = document.getElementById('breakdown-mode').value;
  const scen = document.getElementById('breakdown-scenario').value;
  const bd = scenarioBreakdown[scen];

  // For non-projected years, always show historical
  const fullH1b = [...h1b.slice(0, 5), ...bd.h1b];
  const fullH2a = [...h2a.slice(0, 5), ...bd.h2a];
  const fullH2b = [...h2b.slice(0, 5), ...bd.h2b];

