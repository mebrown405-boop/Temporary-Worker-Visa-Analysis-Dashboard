function handleFile(file) {
  const ext = file.name.split('.').pop().toLowerCase();
  if (!['csv', 'tsv', 'xlsx', 'xls'].includes(ext)) {
    alert('Please upload a CSV, TSV, or Excel file.');
    return;
  }

  uploadFilename.textContent = file.name;
  uploadArea.style.display = 'none';
  uploadStatus.style.display = '';

  const reader = new FileReader();
  reader.onload = function(e) {
    const text = e.target.result;
    parseCSV(text, file.name);
  };

  if (ext === 'csv' || ext === 'tsv') {
    reader.readAsText(file);
  } else {
    // For Excel files, show a message that only CSV is processed client-side
    uploadPreview.innerHTML = '<div style="padding:8px;color:var(--warning);">⚠️ Excel files require server-side processing. Please save as CSV for client-side analysis.</div>';
    uploadedData = null;
  }
}

function parseCSV(text, filename) {
  const lines = text.trim().split(/\r?\n/);
  const sep = text.includes('\t') ? '\t' : ',';
  const headers = lines[0].split(sep).map(h => h.trim().replace(/["\']/g, ''));
  const rows = lines.slice(1).map(l => l.split(sep).map(c => c.trim().replace(/["\']/g, '')));

  // Try to identify columns
  const yearCol = headers.findIndex(h => /year/i.test(h));
  const h1bCol = headers.findIndex(h => /h.?1.?b/i.test(h));
  const h2aCol = headers.findIndex(h => /h.?2.?a/i.test(h));
  const h2bCol = headers.findIndex(h => /h.?2.?b/i.test(h));
  const totalCol = headers.findIndex(h => /total/i.test(h));

  if (yearCol === -1) {
    uploadPreview.innerHTML = '<div style="padding:8px;color:var(--error);">❌ Could not find a "Year" column. Please ensure your CSV has a Year column.</div>';
    uploadedData = null;
    return;
  }

  const parsed = { years: [], h1b: [], h2a: [], h2b: [], total: [], hasCategories: false };

  rows.forEach(row => {
    if (!row[yearCol] || isNaN(parseInt(row[yearCol]))) return;
    const yr = parseInt(row[yearCol]);
    parsed.years.push(yr);

    if (h1bCol >= 0 && h2aCol >= 0 && h2bCol >= 0) {
      parsed.hasCategories = true;
      const v1 = parseFloat(row[h1bCol].replace(/,/g, '')) || 0;
      const v2 = parseFloat(row[h2aCol].replace(/,/g, '')) || 0;
      const v3 = parseFloat(row[h2bCol].replace(/,/g, '')) || 0;
      parsed.h1b.push(v1);
      parsed.h2a.push(v2);
      parsed.h2b.push(v3);
      parsed.total.push(v1 + v2 + v3);
    } else if (totalCol >= 0) {
      parsed.total.push(parseFloat(row[totalCol].replace(/,/g, '')) || 0);
    }
  });

  if (parsed.years.length === 0) {
    uploadPreview.innerHTML = '<div style="padding:8px;color:var(--error);">❌ No valid data rows found.</div>';
    uploadedData = null;
    return;
  }

  uploadedData = parsed;

  // Show preview table
  let previewHTML = '<table><tr><th>Year</th>';
  if (parsed.hasCategories) previewHTML += '<th>H-1B</th><th>H-2A</th><th>H-2B</th>';
  previewHTML += '<th>Total</th></tr>';
  parsed.years.forEach((yr, i) => {
    previewHTML += '<tr><td style="text-align:left;font-weight:600;">' + yr + '</td>';
    if (parsed.hasCategories) {
      previewHTML += '<td>' + fmt(parsed.h1b[i]) + '</td>';
      previewHTML += '<td>' + fmt(parsed.h2a[i]) + '</td>';
      previewHTML += '<td>' + fmt(parsed.h2b[i]) + '</td>';
    }
    previewHTML += '<td><strong>' + fmt(parsed.total[i]) + '</strong></td></tr>';
  });
  previewHTML += '</table>';
  previewHTML += '<div style="margin-top:8px;font-size:11px;color:var(--color-text-muted);">✓ ' + parsed.years.length + ' rows parsed. Data overlaid on chart below.</div>';
  uploadPreview.innerHTML = previewHTML;

  renderCustom();
}

</script>

