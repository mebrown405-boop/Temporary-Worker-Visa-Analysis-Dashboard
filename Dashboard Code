          },
          tooltip: {
            formatter: function() {
              if (!this.point || !this.point.name) return false;
              const p = this.point;
              return '<b>' + p.name + '</b><br/>' +
                'Temp Workers: <b>' + fmt(p.tempWorkers || 0) + '</b><br/>' +
                'Total Pop: <b>' + fmt(p.totalPop || 0) + '</b><br/>' +
                metricLabels[metric] + ': <b>' + (isGrowth ? (p.value || 0) + '%' : fmt(p.value || 0)) + '</b>';
