function getMapData(yearIdx, metric) {
  return Object.entries(countryPopData).map(([code, d]) => {
    const pop = d.pop[yearIdx];
    const tw = Math.round(pop * d.twShare);
    let value;
    if (metric === 'temp_workers') value = tw;
    else if (metric === 'total_pop') value = pop;
    else {
      // growth rate
      if (yearIdx === 0) value = 0;
      else {
        const prev = d.pop[yearIdx - 1];
        value = Math.round(((pop - prev) / prev) * 1000) / 10;
      }
    }
    return { 'hc-key': code, value: value, name: d.name, tempWorkers: tw, totalPop: pop };
  });
}

function renderMap() {
  const yearIdx = parseInt(mapYearSlider.value) - 2019;
  const metric = mapMetric.value;
  mapYearLabel.textContent = 'FY ' + mapYears[yearIdx];

  const data = getMapData(yearIdx, metric);
  const isGrowth = metric === 'growth';

  const metricLabels = {
    temp_workers: 'Estimated Temp Workers',
    total_pop: 'Total Nonimmigrant Population',
    growth: 'Year-over-Year Growth (%)',
  };

  // Fetch map topology
  if (!mapChart) {
    fetch('https://cdn.jsdelivr.net/npm/@highcharts/map-collection@2.3.2/custom/world.topo.json')
