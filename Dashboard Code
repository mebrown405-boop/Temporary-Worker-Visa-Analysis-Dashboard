// ====== CHART: CUSTOM SCENARIO ======
let uploadedData = null;

function renderCustom() {
  const h1bMult = parseFloat(document.getElementById('h1b-slider').value);
  const h2aMult = parseFloat(document.getElementById('h2a-slider').value);
  const h2bMult = parseFloat(document.getElementById('h2b-slider').value);
  const disType = document.getElementById('disruption-type').value;
  const disYear = parseInt(document.getElementById('disruption-year').value);
  const severity = parseInt(document.getElementById('severity-slider').value);
  const sevLabels = ['Low', 'Medium', 'High'];

  document.getElementById('h1b-val').textContent = h1bMult.toFixed(1) + '×';
  document.getElementById('h2a-val').textContent = h2aMult.toFixed(1) + '×';
  document.getElementById('h2b-val').textContent = h2bMult.toFixed(1) + '×';
  document.getElementById('severity-val').textContent = sevLabels[severity - 1];

  const h1bGrowth = (h1b[4] - h1b[0]) / 4;
  const h2aGrowth = (h2a[4] - h2a[0]) / 4;
  const h2bGrowth = (h2b[4] - h2b[0]) / 4;
  const sevMult = severity * 0.4; // 0.4, 0.8, 1.2

  const customH1b = [], customH2a = [], customH2b = [], customTotal = [];

  for (let i = 0; i < 8; i++) {
    let ch1 = h1b[4] + h1bGrowth * (i + 1) * h1bMult;
    let ch2a_v = h2a[4] + h2aGrowth * (i + 1) * h2aMult;
    let ch2b_v = h2b[4] + h2bGrowth * (i + 1) * h2bMult;
    const year = 2025 + i;

    if (disType !== 'none') {
      const yearDiff = year - disYear;

      if (disType === 'recession') {
        if (yearDiff === 0) { ch1 *= (1 - 0.3 * sevMult); ch2a_v *= (1 - 0.2 * sevMult); ch2b_v *= (1 - 0.25 * sevMult); }
        else if (yearDiff === 1) { ch1 *= (1 - 0.15 * sevMult); ch2a_v *= (1 - 0.1 * sevMult); ch2b_v *= (1 - 0.12 * sevMult); }
        else if (yearDiff === 2) { ch1 *= (1 - 0.05 * sevMult); }
      } else if (disType === 'disaster') {
        if (yearDiff === 0) { ch1 *= (1 - 0.1 * sevMult); ch2a_v *= (1 - 0.4 * sevMult); ch2b_v *= (1 - 0.25 * sevMult); }
        else if (yearDiff === 1) { ch1 *= (1 - 0.03 * sevMult); ch2a_v *= (1 - 0.12 * sevMult); ch2b_v *= (1 - 0.08 * sevMult); }
        else if (yearDiff === 2) { ch2a_v *= (1 + 0.05 * sevMult); ch2b_v *= (1 + 0.05 * sevMult); } // rebuild surge
      } else if (disType === 'political') {
        if (yearDiff >= -1 && yearDiff <= 0) { ch1 *= (1 - 0.08 * sevMult); ch2a_v *= (1 - 0.05 * sevMult); ch2b_v *= (1 - 0.07 * sevMult); }
        if (yearDiff === 1) { ch1 *= (1 - 0.3 * sevMult); ch2a_v *= (1 - 0.15 * sevMult); ch2b_v *= (1 - 0.25 * sevMult); }
        else if (yearDiff === 2) { ch1 *= (1 - 0.25 * sevMult); ch2a_v *= (1 - 0.12 * sevMult); ch2b_v *= (1 - 0.2 * sevMult); }
        else if (yearDiff === 3) { ch1 *= (1 - 0.15 * sevMult); ch2a_v *= (1 - 0.08 * sevMult); ch2b_v *= (1 - 0.1 * sevMult); }
        else if (yearDiff === 4) { ch1 *= (1 - 0.08 * sevMult); ch2a_v *= (1 - 0.03 * sevMult); ch2b_v *= (1 - 0.05 * sevMult); }
      }
    }

    customH1b.push(Math.round(Math.max(0, ch1)));
    customH2a.push(Math.round(Math.max(0, ch2a_v)));
    customH2b.push(Math.round(Math.max(0, ch2b_v)));
    customTotal.push(Math.round(Math.max(0, ch1) + Math.max(0, ch2a_v) + Math.max(0, ch2b_v)));
  }

  // Also show baseline for reference
  Highcharts.chart('chart-custom', {
    chart: { backgroundColor: 'transparent' },
    title: { text: 'Custom Scenario Projection (2025–2032)', style: { fontSize: '15px', fontWeight: '600' } },
    xAxis: { categories: projectedYears.map(String) },
    yAxis: { title: { text: 'Visa Volume' }, labels: { format: '{value:,.0f}' } },
    tooltip: { shared: true, pointFormat: '<span style="color:{series.color}">●</span> {series.name}: <b>{point.y:,.0f}</b><br/>' },
    series: [
      { name: 'Custom Total', data: customTotal, type: 'area', color: '#6554C0', lineWidth: 3, fillOpacity: 0.1 },
      { name: 'H-1B', data: customH1b, type: 'line', color: '#0052CC', lineWidth: 1.5, dashStyle: 'Dash' },
