          title: { text: null },
          mapNavigation: { enabled: true, buttonOptions: { verticalAlign: 'bottom' } },
          colorAxis: {
            min: isGrowth ? -20 : 0,
            max: isGrowth ? 50 : undefined,
            stops: isGrowth
              ? [[0, '#de350b'], [0.4, '#fff3e0'], [1, '#36b37e']]
