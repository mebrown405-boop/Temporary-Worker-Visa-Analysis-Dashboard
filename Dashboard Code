<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Temp Workers Visa Dashboard</title>
  <script src="/vendor/highcharts/highcharts.js"></script>
  <script src="/vendor/highcharts/modules/accessibility.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/highcharts@12.1.2/modules/map.js"></script>
  <style>
    :root {
      --primary: #0052CC;
      --primary-light: #ebf3ff;
      --success: #36b37e;
      --error: #de350b;
      --warning: #ff991f;
      --purple: #6554C0;
      --teal: #00b8d9;
      --magenta: #c2185b;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--color-bg, #f4f5f7);
      font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
      color: var(--color-text, #172b4d);
      padding: 24px;
      line-height: 1.5;
    }

    .dashboard-header {
      text-align: center;
      margin-bottom: 28px;
    }

    .dashboard-header h1 {
      font-size: 22px;
      font-weight: 700;
      color: var(--color-text, #172b4d);
      margin-bottom: 6px;
    }

    .dashboard-header p {
      color: var(--color-text-muted, #8993a4);
      font-size: 14px;
    }

    .kpi-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
      margin-bottom: 24px;
    }

    .kpi-card {
      background: var(--color-surface, #ffffff);
      border: 1px solid var(--color-border-light, #ebecf0);
      border-radius: 10px;
      padding: 16px 18px;
      text-align: center;
    }

    .kpi-card .label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-muted, #8993a4);
      margin-bottom: 4px;
    }

    .kpi-card .value {
      font-size: 22px;
      font-weight: 700;
    }

    .kpi-card .trend {
      font-size: 12px;
      margin-top: 4px;
    }

    .trend.up { color: var(--success); }
    .trend.down { color: var(--error); }

    .section-tabs {
      display: flex;
      gap: 0;
      margin-bottom: 0;
      border-bottom: 2px solid var(--color-border-light, #ebecf0);
      overflow-x: auto;
    }

    .tab-btn {
      background: none;
      border: none;
      padding: 10px 18px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      color: var(--color-text-muted, #8993a4);
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
      transition: all 0.2s;
      white-space: nowrap;
    }

    .tab-btn.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
    }

    .tab-btn:hover:not(.active) {
      color: var(--color-text-secondary, #44546f);
    }

    .card {
      background: var(--color-surface, #ffffff);
      border: 1px solid var(--color-border-light, #ebecf0);
      border-radius: 10px;
      padding: 20px;
      margin-bottom: 20px;
    }

    .chart-container {
      height: 380px;
    }

    .controls-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      margin-bottom: 16px;
      padding: 14px 18px;
      background: var(--color-bg-secondary, #f4f5f7);
      border-radius: 8px;
    }

    .controls-row label {
      font-size: 12px;
      font-weight: 600;
      color: var(--color-text-secondary, #44546f);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .controls-row select, .controls-row input[type="range"] {
      font-size: 13px;
      padding: 6px 10px;
      border: 1px solid var(--color-border, #dfe1e6);
      border-radius: 6px;
      background: var(--color-surface, #fff);
      color: var(--color-text, #172b4d);
    }

    .scenario-toggles {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .scenario-toggle {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border: 1px solid var(--color-border-light, #ebecf0);
      border-radius: 20px;
      background: var(--color-surface, #fff);
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      user-select: none;
    }

    .scenario-toggle.active {
      border-color: currentColor;
      background: color-mix(in srgb, currentColor 8%, white);
    }

    .scenario-toggle .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .comparison-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 16px;
    }

    @media (max-width: 800px) {
      .comparison-grid { grid-template-columns: 1fr; }
    }

    .data-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 13px;
    }

    .data-table th {
      text-align: left;
      padding: 10px 12px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-muted, #8993a4);
      border-bottom: 1px solid var(--color-border-light, #ebecf0);
      position: sticky;
      top: 0;
      background: var(--color-surface, #fff);
    }

    .data-table td {
      padding: 9px 12px;
      border-bottom: 1px solid var(--color-border-light, #ebecf0);
      color: var(--color-text-secondary, #44546f);
    }

    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover td { background: var(--color-bg-secondary, #f9fafb); }
    .data-table .num { text-align: right; font-variant-numeric: tabular-nums; }

    .slider-container {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .slider-container input[type="range"] {
      width: 140px;
    }

    .slider-value {
      font-size: 11px;
      color: var(--color-text-muted, #8993a4);
      text-align: center;
    }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .insight-box {
      background: var(--primary-light);
      border: 1px solid #b3d4ff;
      border-radius: 8px;
      padding: 14px 16px;
      margin-top: 16px;
      font-size: 13px;
      color: #0747a6;
    }

    .insight-box strong { display: block; margin-bottom: 4px; }

    .scenario-detail-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
      margin-top: 16px;
    }

    .scenario-detail-card {
      border: 1px solid var(--color-border-light, #ebecf0);
      border-radius: 8px;
      padding: 16px;
      background: var(--color-surface, #fff);
    }

    .scenario-detail-card h4 {
      font-size: 13px;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .scenario-detail-card .impact-list {
      font-size: 12px;
      color: var(--color-text-secondary, #44546f);
      list-style: none;
      padding: 0;
    }

    .scenario-detail-card .impact-list li {
      padding: 3px 0;
      border-bottom: 1px solid var(--color-border-light, #ebecf0);
    }

    .scenario-detail-card .impact-list li:last-child { border-bottom: none; }


    .upload-panel {
      margin-bottom: 16px;
    }

    .upload-area {
      border: 2px dashed var(--color-border, #dfe1e6);
      border-radius: 10px;
      padding: 24px;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s;
    }

    .upload-area:hover, .upload-area.dragover {
      border-color: var(--primary);
      background: var(--primary-light);
    }

    .upload-icon {
      font-size: 28px;
      margin-bottom: 8px;
    }

    .upload-text {
      font-size: 14px;
      color: var(--color-text, #172b4d);
      margin-bottom: 4px;
    }

    .upload-subtext {
      font-size: 12px;
      color: var(--color-text-muted, #8993a4);
      margin-bottom: 12px;
    }

    .upload-subtext code {
      background: var(--color-bg-secondary, #f4f5f7);
      padding: 1px 5px;
      border-radius: 3px;
      font-size: 11px;
    }

    .upload-btn {
      padding: 8px 18px;
      font-size: 13px;
      font-weight: 600;
      border: none;
      border-radius: 6px;
      background: var(--primary);
      color: #fff;
      cursor: pointer;
      transition: background 0.2s;
    }

    .upload-btn:hover {
      background: #0747a6;
    }

    .upload-status {
      border: 1px solid var(--color-border-light, #ebecf0);
      border-radius: 8px;
      padding: 14px;
    }

    .upload-file-info {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
    }

    .upload-file-icon {
      font-size: 16px;
    }

    #upload-filename {
      font-size: 13px;
      font-weight: 600;
      color: var(--color-text, #172b4d);
      flex: 1;
    }

    .upload-remove {
      background: none;
      border: none;
      font-size: 16px;
      color: var(--color-text-muted, #8993a4);
      cursor: pointer;
      padding: 2px 6px;
      border-radius: 4px;
    }

    .upload-remove:hover {
      background: var(--color-bg-secondary, #f4f5f7);
      color: var(--error);
    }

    .upload-preview {
      max-height: 160px;
      overflow-y: auto;
      font-size: 12px;
    }

    .upload-preview table {
      width: 100%;
      border-collapse: collapse;
    }

    .upload-preview th, .upload-preview td {
      padding: 4px 8px;
      border: 1px solid var(--color-border-light, #ebecf0);
      font-size: 11px;
      text-align: right;
    }

    .upload-preview th {
      background: var(--color-bg-secondary, #f4f5f7);
      text-align: left;
      font-weight: 600;
    }

    .resource-section {
      margin-bottom: 24px;
    }

    .resource-section:last-child {
      margin-bottom: 0;
    }

    .resource-category {
      font-size: 13px;
      font-weight: 700;
      color: var(--color-text-secondary, #44546f);
      margin-bottom: 10px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--color-border-light, #ebecf0);
    }

    .resource-item {
      display: flex;
      gap: 14px;
      padding: 12px 14px;
      border: 1px solid var(--color-border-light, #ebecf0);
      border-radius: 8px;
      margin-bottom: 8px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .resource-item:hover {
      border-color: var(--color-border, #dfe1e6);
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .resource-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      flex-shrink: 0;
    }

    .resource-icon.data { background: #e3f2fd; }
    .resource-icon.article { background: #fce4ec; }
    .resource-icon.method { background: #e8f5e9; }

    .resource-info { flex: 1; }

    .resource-info .title {
      font-size: 13px;
      font-weight: 600;
      color: var(--color-text, #172b4d);
      margin-bottom: 3px;
    }

    .resource-info .title a {
      color: var(--primary);
      text-decoration: none;
    }

    .resource-info .title a:hover {
      text-decoration: underline;
    }

    .resource-info .description {
      font-size: 12px;
      color: var(--color-text-muted, #8993a4);
      line-height: 1.4;
    }

    .resource-info .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 6px;
    }

    .resource-tag {
      font-size: 10px;
      padding: 2px 8px;
      border-radius: 10px;
      background: var(--color-bg-secondary, #f4f5f7);
      color: var(--color-text-secondary, #44546f);
      font-weight: 500;
    }

    .resource-count {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 12px;
      color: var(--color-text-muted, #8993a4);
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid var(--color-border-light, #ebecf0);
    }

  </style>
</head>
<body>

<div class="dashboard-header">
  <h1>Temporary Worker Visa Analysis Dashboard</h1>
  <p>Interactive comparison of H-1B, H-2A, and H-2B visa volumes (2020–2032) with scenario modeling</p>
</div>

<div class="kpi-row" id="kpi-row"></div>

<div class="section-tabs">
  <button class="tab-btn active" data-tab="overview">Overview</button>
  <button class="tab-btn" data-tab="breakdown">Visa Breakdown</button>
  <button class="tab-btn" data-tab="data">Data Table</button>
  <button class="tab-btn" data-tab="map">Global Map</button>
  <button class="tab-btn" data-tab="scenarios">Scenario Comparison</button>
  <button class="tab-btn" data-tab="custom">Custom Scenario Builder</button>
  <button class="tab-btn" data-tab="resources">Resources</button>
</div>

<!-- OVERVIEW TAB -->
<div class="tab-content active" id="tab-overview">
  <div class="card" style="margin-top: 16px;">
    <div class="chart-container" id="chart-overview"></div>
  </div>
  <div class="insight-box">
    <strong>📊 Key Insight</strong>
    Total temp worker visa volumes are projected to grow from ~767K in 2025 to ~1.24M by 2032 under baseline conditions — a 61% increase driven primarily by H-1B growth (+94%) and steady H-2A agricultural demand.
  </div>
  <div class="comparison-grid" style="margin-top: 16px;">
    <div class="card">
      <h3 style="font-size: 14px; margin-bottom: 12px;">Resident Population vs. Visa Issuances</h3>
      <div id="chart-stock-flow" style="height: 260px;"></div>
    </div>
    <div class="card">
      <h3 style="font-size: 14px; margin-bottom: 12px;">Demographics & Context (FY 2024)</h3>
      <div id="chart-demographics" style="height: 260px;"></div>
    </div>
  </div>
  <div class="insight-box" style="margin-top: 12px; background: #e8f5e9; border-color: #a5d6a7; color: #1b5e20;">
    <strong>🛡️ COVID Resilience Finding (DHS/OHSS 2025)</strong>
    Temp worker population grew steadily even during the pandemic (1.42M→1.48M, 2019–2021), while international students fell 20%. This structural resilience suggests that economic demand for temp workers is more robust to disruption than other nonimmigrant categories — informing the moderate baseline assumptions in our recession scenario.
  </div>
  <div class="insight-box" style="margin-top: 12px; background: #fff3e0; border-color: #ffcc80; color: #e65100;">
    <strong>📈 Procyclical Demand & Differential Sensitivity (CRS R47159)</strong>
    Professional temp worker visas are confirmed procyclical — tracking economic expansion and contraction. During COVID, professional workers (H-1B) saw a <strong>43% drop</strong> in visa issuances, while total H-2A/H-2B seasonal workers remained stable. This validates differential crisis sensitivity: H-1B is 3–4× more volatile than H-2A/H-2B during disruptions. Long-term trend: professional visas doubled from ~200K (1997) to ~425K (2019), outpacing total nonimmigrant growth by 2×.
  </div>
</div>

<!-- SCENARIOS TAB -->
<div class="tab-content" id="tab-scenarios">
  <div class="card" style="margin-top: 16px;">
    <div class="controls-row">
      <span style="font-size: 13px; font-weight: 600;">Toggle Scenarios:</span>
      <div class="scenario-toggles" id="scenario-toggles"></div>
    </div>
    <div class="chart-container" id="chart-scenarios"></div>
  </div>
  <div class="scenario-detail-grid">
    <div class="scenario-detail-card">
      <h4><span style="color:#0052CC;">●</span> Baseline</h4>
      <ul class="impact-list">
        <li>Current growth trajectory maintained</li>
        <li>No major policy changes or disruptions</li>
        <li>H-1B: +94% | H-2A: +39% | H-2B: +64%</li>
      </ul>
    </div>
    <div class="scenario-detail-card">
      <h4><span style="color:#de350b;">●</span> Policy Restriction (−25%)</h4>
      <ul class="impact-list">
        <li>25% cap reduction across all categories</li>
        <li>Phased implementation starting 2025</li>
        <li>All categories reduced proportionally</li>
      </ul>
    </div>
    <div class="scenario-detail-card">
      <h4><span style="color:#36b37e;">●</span> Policy Expansion (+30%)</h4>
      <ul class="impact-list">
        <li>30% increase in visa allocations</li>
        <li>Bipartisan reform passes in 2025</li>
        <li>Strongest growth in H-1B tech sector</li>
      </ul>
    </div>
    <div class="scenario-detail-card">
      <h4><span style="color:#ff991f;">●</span> Economic Recession (2027)</h4>
      <ul class="impact-list">
        <li>Sharp downturn in 2027, gradual recovery</li>
        <li>Procyclical pattern confirmed by CRS: visas track economic cycles</li>
        <li>H-1B most sensitive: -43% during COVID (CRS R47159)</li>
        <li>H-2A/H-2B more resilient (DHS: steady growth through pandemic)</li>
        <li>Full recovery by 2031–2032</li>
      </ul>
    </div>
    <div class="scenario-detail-card">
      <h4><span style="color:#00b8d9;">●</span> Natural Disaster (2027)</h4>
      <ul class="impact-list">
        <li>Major event (hurricane/wildfire) in 2027</li>
        <li>H-2A hardest hit (−40%): farm/crop destruction</li>
        <li>H-2B moderate (−25%): seasonal disruption</li>
        <li>H-1B minimal (−10%): office-based, insulated</li>
        <li>Post-disaster rebuilding surge in 2029</li>
      </ul>
    </div>
    <div class="scenario-detail-card">
      <h4><span style="color:#c2185b;">●</span> Political Instability (2026–2029)</h4>
      <ul class="impact-list">
        <li>Sustained policy uncertainty over 3+ years</li>
        <li>H-1B hardest hit (−30%): politically sensitive (CRS: key focus of policy debate)</li>
        <li>H-2A somewhat shielded (−15%): bipartisan agricultural support</li>
        <li>Static caps + per-country limits amplify uncertainty (CRS R47159)</li>
        <li>Processing delays & employer hesitancy</li>
        <li>Slow recovery — effects linger through 2031</li>
      </ul>
    </div>
  </div>
  <div class="comparison-grid">
    <div class="card">
      <h3 style="font-size: 14px; margin-bottom: 12px;">2032 Endpoint Comparison</h3>
      <div class="chart-container" id="chart-endpoint" style="height: 260px;"></div>
    </div>
    <div class="card">
      <h3 style="font-size: 14px; margin-bottom: 12px;">Maximum Drawdown from Baseline</h3>
      <div class="chart-container" id="chart-drawdown" style="height: 260px;"></div>
    </div>
  </div>
</div>

<!-- BREAKDOWN TAB -->
<div class="tab-content" id="tab-breakdown">
  <div class="card" style="margin-top: 16px;">
    <div class="controls-row">
      <label>View Mode:
        <select id="breakdown-mode">
          <option value="stacked">Stacked Area</option>
          <option value="individual">Individual Lines</option>
          <option value="percentage">Percentage Share</option>
        </select>
      </label>
      <label>Scenario:
        <select id="breakdown-scenario">
          <option value="baseline">Baseline</option>
          <option value="restriction">Policy Restriction</option>
          <option value="expansion">Policy Expansion</option>
          <option value="recession">Economic Recession</option>
          <option value="disaster">Natural Disaster</option>
          <option value="political">Political Instability</option>
        </select>
      </label>
    </div>
    <div class="chart-container" id="chart-breakdown"></div>
  </div>
</div>

<!-- CUSTOM SCENARIO TAB -->
<div class="tab-content" id="tab-custom">
  <div class="card" style="margin-top: 16px;">
    <div class="controls-row" style="flex-direction: column; align-items: stretch;">
      <div style="font-size: 13px; font-weight: 600; margin-bottom: 8px;">Adjust Growth Rate Multipliers & Disruption Events</div>
      <div style="display: flex; flex-wrap: wrap; gap: 20px;">
        <div class="slider-container">
          <label>H-1B Growth: <span id="h1b-val">1.0×</span></label>
          <input type="range" id="h1b-slider" min="0" max="2" step="0.1" value="1">
        </div>
        <div class="slider-container">
          <label>H-2A Growth: <span id="h2a-val">1.0×</span></label>
          <input type="range" id="h2a-slider" min="0" max="2" step="0.1" value="1">
        </div>
        <div class="slider-container">
          <label>H-2B Growth: <span id="h2b-val">1.0×</span></label>
          <input type="range" id="h2b-slider" min="0" max="2" step="0.1" value="1">
        </div>
        <div class="slider-container">
          <label>Disruption Type:
            <select id="disruption-type">
              <option value="recession">Recession</option>
              <option value="disaster">Natural Disaster</option>
              <option value="political">Political Instability</option>
              <option value="none">None</option>
            </select>
          </label>
        </div>
        <div class="slider-container">
          <label>Disruption Year:
            <select id="disruption-year">
              <option value="2026">2026</option>
              <option value="2027" selected>2027</option>
              <option value="2028">2028</option>
              <option value="2029">2029</option>
              <option value="2030">2030</option>
            </select>
          </label>
        </div>
        <div class="slider-container">
          <label>Severity: <span id="severity-val">Medium</span></label>
          <input type="range" id="severity-slider" min="1" max="3" step="1" value="2">
        </div>
      </div>
    </div>
    <div class="upload-panel" id="upload-panel">
      <div class="upload-area" id="upload-area">
        <div class="upload-icon">📂</div>
        <div class="upload-text"><strong>Upload Your Own Dataset</strong></div>
        <div class="upload-subtext">Drag & drop a CSV/Excel file or click to browse.<br>Expected columns: <code>Year, H1B, H2A, H2B</code> (or <code>Year, Total</code>)</div>
        <input type="file" id="file-input" accept=".csv,.xlsx,.xls,.tsv" style="display:none;">
        <button class="upload-btn" id="upload-btn">Choose File</button>
      </div>
      <div class="upload-status" id="upload-status" style="display:none;">
        <div class="upload-file-info">
          <span class="upload-file-icon">✅</span>
          <span id="upload-filename">dataset.csv</span>
          <button class="upload-remove" id="upload-remove">✕</button>
        </div>
        <div class="upload-preview" id="upload-preview"></div>
