}

function renderRanking(yearIdx) {
  const rankings = Object.entries(countryPopData)
    .map(([code, d]) => ({ code, name: d.name, tw: Math.round(d.pop[yearIdx] * d.twShare), selected: code === selectedCountry }))
    .sort((a, b) => b.tw - a.tw)
    .slice(0, 8);

  const maxTw = rankings[0].tw;
  document.getElementById('map-ranking').innerHTML = rankings.map((r, i) => {
    const pct = (r.tw / maxTw * 100).toFixed(0);
    const highlight = r.selected ? 'border-left: 3px solid var(--primary); padding-left: 8px;' : 'padding-left: 11px;';
    return '<div style="margin-bottom:6px;' + highlight + '">' +
      '<div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:2px;">' +
      '<span style="font-weight:' + (r.selected ? '700' : '500') + ';">' + (i+1) + '. ' + r.name + '</span>' +
      '<span style="font-weight:600;">' + fmt(r.tw) + '</span></div>' +
      '<div style="height:4px;background:var(--color-border-light,#ebecf0);border-radius:2px;overflow:hidden;">' +
      '<div style="height:100%;width:' + pct + '%;background:var(--primary);border-radius:2px;"></div></div></div>';
  }).join('');
}

